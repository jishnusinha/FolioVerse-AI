{
	admin off
	auto_https off
	persist_config off
}

# FV_API_UPSTREAM: compose uses api-http:3000; Cloud Run (lean env) sets the api-http service URL.
# FV_OTLP_UPSTREAM: optional collector for browser spans (builds with VITE_OTEL_ENABLED=true).
:8080 {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Default only: this block is deferred (it deletes Server), so /docs/* can set its own policy below.
		?Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	handle /healthz {
		respond 200
	}

	handle /api/* {
		# SSE endpoints must not be buffered.
		reverse_proxy {$FV_API_UPSTREAM:api-http:3000} {
			header_up Host {upstream_hostport}
			flush_interval -1
		}
	}

	handle_path /otlp/* {
		request_body {
			max_size 1MB
		}
		reverse_proxy {$FV_OTLP_UPSTREAM:otel-collector:4318}
	}

	# Documentation site (apps/docs, built into /srv/docs). docs-csp.caddy is generated by the docs build and
	# replaces the CSP above with one that allows Starlight's hashed inline scripts and Pagefind's WebAssembly.
	redir /docs /docs/ 308

	handle /docs/* {
		import /etc/caddy/docs-csp*.caddy
		root * /srv
		@docsAssets path /docs/_astro/*
		header @docsAssets Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle_errors 404 {
		@docs path /docs/*
		handle @docs {
			import /etc/caddy/docs-csp*.caddy
			root * /srv
			rewrite * /docs/404.html
			file_server
		}
	}

	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
