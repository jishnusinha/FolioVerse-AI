{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "folioverse",
      "folder": "FolioVerse",
      "interval": "1m",
      "rules": [
        {
          "uid": "fv-run-failures",
          "title": "Run failure rate above 20%",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 3600,
                "to": 0
              },
              "datasourceUid": "fv-prometheus",
              "model": {
                "refId": "A",
                "expr": "sum(increase(fv_runs_total{status=~\"FAILED|INTERRUPTED\"}[15m])) / clamp_min(sum(increase(fv_runs_total[15m])), 1)",
                "instant": true
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0.2
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "10m",
          "labels": {
            "severity": "warning",
            "service": "folioverse"
          },
          "annotations": {
            "summary": "Run failure rate above 20%",
            "runbook_url": "infrastructure/runbooks/deploy.md#rollback"
          }
        },
        {
          "uid": "fv-ingestion-failures",
          "title": "More than 5 ingestion failures in 30 minutes",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 3600,
                "to": 0
              },
              "datasourceUid": "fv-prometheus",
              "model": {
                "refId": "A",
                "expr": "sum(increase(fv_ingestion_jobs_total{state=~\"FAILED|QUARANTINED\"}[30m]))",
                "instant": true
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        5
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "0m",
          "labels": {
            "severity": "warning",
            "service": "folioverse"
          },
          "annotations": {
            "summary": "More than 5 ingestion failures in 30 minutes",
            "runbook_url": "infrastructure/runbooks/deploy.md#health-checks"
          }
        },
        {
          "uid": "fv-queue-backlog",
          "title": "Queue backlog above 100 jobs",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 3600,
                "to": 0
              },
              "datasourceUid": "fv-prometheus",
              "model": {
                "refId": "A",
                "expr": "max(fv_queue_depth)",
                "instant": true
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        100
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "10m",
          "labels": {
            "severity": "warning",
            "service": "folioverse"
          },
          "annotations": {
            "summary": "Queue backlog above 100 jobs",
            "runbook_url": "infrastructure/runbooks/purge-job.md#queue-backlog"
          }
        },
        {
          "uid": "fv-unpriced-usage",
          "title": "Usage recorded without a price",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 3600,
                "to": 0
              },
              "datasourceUid": "fv-prometheus",
              "model": {
                "refId": "A",
                "expr": "sum(increase(fv_ledger_entries_total{tier=\"FINAL_ESTIMATED\",is_demo=\"false\"}[1h]))",
                "instant": true
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "0m",
          "labels": {
            "severity": "info",
            "service": "folioverse"
          },
          "annotations": {
            "summary": "Usage recorded without a price",
            "runbook_url": "infrastructure/runbooks/rotate-secrets.md#model-prices"
          }
        },
        {
          "uid": "fv-spend-spike",
          "title": "Real AI spend above $5 in an hour",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 3600,
                "to": 0
              },
              "datasourceUid": "fv-prometheus",
              "model": {
                "refId": "A",
                "expr": "sum(increase(fv_ledger_charged_usd_total{is_demo=\"false\",cost_class=\"AI_API\"}[1h]))",
                "instant": true
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        5
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "0m",
          "labels": {
            "severity": "critical",
            "service": "folioverse"
          },
          "annotations": {
            "summary": "Real AI spend above $5 in an hour",
            "runbook_url": "infrastructure/runbooks/rotate-secrets.md#suspected-key-abuse"
          }
        }
      ]
    }
  ]
}
