{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "FindTaggedInstancesNoResourceLevelSupport",
      "Effect": "Allow",
      "Action": ["ec2:DescribeInstances", "ec2:DescribeInstanceStatus", "tag:GetResources"],
      "Resource": "*"
    },
    {
      "Sid": "DeploymentFailureNotifications",
      "Effect": "Allow",
      "Action": "sns:Publish",
      "Resource": "arn:aws:sns:<REGION>:<ACCOUNT_ID>:folioverse-staging-deployments"
    },
    {
      "Sid": "AlarmBasedRollbackNoResourceLevelSupport",
      "Effect": "Allow",
      "Action": "cloudwatch:DescribeAlarms",
      "Resource": "*"
    }
  ]
}
