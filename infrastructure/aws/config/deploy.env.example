# /etc/folioverse/deploy.env — non-secret settings for the FolioVerse AWS staging host.
# Copied here by scripts/bootstrap-ec2.sh on first run; edit it on the EC2 host (root-owned, 0640).
# Read by the deployment scripts and passed to `docker compose --env-file`.
# Format: KEY=value, one per line, no quotes, no spaces around "=". Never put secrets in this file:
# secrets live in AWS Secrets Manager (FV_SECRET_ID) and are rendered by scripts/load-secrets.sh.

# ---- AWS ----
AWS_REGION=ap-south-1
# <ACCOUNT_ID>.dkr.ecr.<REGION>.amazonaws.com
FV_ECR_REGISTRY=<ACCOUNT_ID>.dkr.ecr.ap-south-1.amazonaws.com
# Name or ARN of the Secrets Manager JSON secret (see config/secret-keys.example.json).
FV_SECRET_ID=folioverse/staging/app
# Existing private S3 bucket for uploaded documents. The application never creates buckets.
FV_DOCUMENTS_BUCKET=<DOCUMENTS_BUCKET>
# Private S3 bucket for scripts/backup.sh. Leave empty to disable the nightly backup timer.
FV_BACKUP_BUCKET=<BACKUP_BUCKET>

# ---- Host ----
# Mount point of the separately attached, encrypted EBS data volume (scripts/prepare-data-volume.sh).
FV_DATA_DIR=/srv/folioverse-data
# Docker subnet shared by the TLS edge and the web container; must not overlap the VPC CIDR.
FV_EDGE_SUBNET=10.250.250.0/24

# ---- Public endpoint ----
# DNS A record pointing at the instance's Elastic IP. APP_ORIGIN becomes https://<FV_DOMAIN>.
FV_DOMAIN=<DOMAIN>
# Let's Encrypt account email (expiry notices).
FV_ACME_EMAIL=<ACME_EMAIL>

# ---- Application (non-secret) ----
# The account registering with this email becomes SUPER_ADMIN. Register it right after the first deployment.
FV_SEED_ADMIN_EMAIL=
FV_ALLOW_REGISTRATION=true
# Email is off for this staging deployment: verification, password-reset and invitation emails are not sent.
# To enable: set true here and add SMTP_URL to the Secrets Manager secret.
FV_MAIL_ENABLED=false
FV_MAIL_FROM=FolioVerse <no-reply@folioverse.invalid>
FV_MAX_UPLOAD_MB=64
FV_DEFAULT_MONTHLY_BUDGET=5.00
# true loads the synthetic DEMO discovery catalog (labelled DEMO in the UI) during the seed step.
FV_DEMO_CATALOG=false
FV_LOG_LEVEL=info
