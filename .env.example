# FolioVerse environment template. Copy to .env (or run `pnpm up`, which generates secrets locally).
# Never commit .env. Values below are local-development defaults only; secrets are left empty and
# are generated by infrastructure/scripts/gen-keys.mjs (values are never printed).
# Variables marked [required] fail fast at startup with the variable name (never the value).

# ---- General ----
NODE_ENV=development
LOG_LEVEL=info
# Public origin of the web app (cookies, CORS, links in emails).
APP_ORIGIN=http://localhost:8080
# API HTTP port (native dev). In Docker the API listens on 3000 behind Caddy.
PORT=3000

# ---- Database / cache ----
# [required] Postgres 16. Prisma uses schemas app, ai (and rec from Gate 7).
DATABASE_URL=postgresql://folioverse:folioverse@localhost:5432/folioverse?schema=app
REDIS_URL=redis://localhost:6379

# ---- Auth ----
# [required] HS256 secret for the 10-minute access cookie (>= 32 chars). Generated by gen-keys.
FV_JWT_SECRET=
# [required] ES256 key pair for API -> AI service tokens and scope tokens (PEM, \n-escaped). Generated by gen-keys.
FV_INTERNAL_JWT_PRIVATE_KEY=
FV_INTERNAL_JWT_PUBLIC_KEY=
# Set true behind HTTPS (production).
COOKIE_SECURE=false
FV_ALLOW_REGISTRATION=true
# The account registering with this email becomes SUPER_ADMIN (cost admin, price entry).
FV_SEED_ADMIN_EMAIL=

# ---- Email (Mailpit locally: http://localhost:8025) ----
SMTP_URL=smtp://localhost:1025
MAIL_FROM=FolioVerse <no-reply@folioverse.local>

# ---- Object storage (S3 API: SeaweedFS locally; GCS via its S3-compatible XML API + HMAC keys) ----
STORAGE_ENDPOINT=http://localhost:9000
# Endpoint browsers use for signed URLs (when FV_UPLOAD_MODE=signed).
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=folioverse
# Local SeaweedFS placeholders only; set real credentials for any shared or cloud deployment.
STORAGE_ACCESS_KEY=folioverse
STORAGE_SECRET_KEY=folioverse-secret
STORAGE_FORCE_PATH_STYLE=true
# proxy: uploads stream through the API (works everywhere). signed: browser PUTs to storage directly.
FV_UPLOAD_MODE=proxy
FV_MAX_UPLOAD_MB=64

# ---- AI service (FastAPI) ----
FV_AI_API_URL=http://localhost:8000
FV_AI_INGEST_URL=http://localhost:8001
QDRANT_URL=http://localhost:6333
FV_QDRANT_COLLECTION=fv_chunks_v1
# fastembed: BAAI/bge-small-en-v1.5 dense + Qdrant/bm25 sparse (CPU, downloaded on first use).
# hash: deterministic test embedder (no download, lexical quality only).
FV_EMBEDDER=fastembed
FV_RERANK=false
# postgres: LangGraph checkpoints in schema `langgraph` (time machine, fork). memory: tests only.
FV_CHECKPOINTER=postgres
FV_CONTEXT_BUDGET_TOKENS=3500
FV_TOP_K=6
# Delay between mock tokens so streaming is visible in demos.
FV_MOCK_TOKEN_DELAY_MS=12

# ---- Model providers (all optional; without them the deterministic DEMO mock model is used) ----
# Model ids are never hard-coded: set the exact model you are entitled to use.
OPENAI_API_KEY=
FV_OPENAI_MODEL=
FV_OPENAI_FALLBACK_MODEL=
# Local models via Ollama (docker compose --profile local-llm).
FV_OLLAMA_URL=
FV_OLLAMA_MODEL=

# ---- Budgets & lab ----
# Default monthly budget per workspace (USD).
FV_DEFAULT_MONTHLY_BUDGET=5.00
# Allows Studio failure injection on lab runs. Keep false in production.
FV_LAB_FAULTS=true

# ---- Observability (optional; docker compose --profile observability) ----
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---- Tests ----
# Live provider tests consume paid tokens; they only run when explicitly set to 1.
FV_LIVE_PROVIDER_TESTS=0
