{
  "name": "@folioverse/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/src/main.js",
    "start:worker": "node dist/src/worker.js",
    "dev:worker": "nest start --watch --entryFile src/worker --path tsconfig.worker.json",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --config jest.config.js",
    "test:integration": "jest --config jest.integration.config.js --runInBand",
    "db:generate": "prisma generate",
    "db:migrate": "node ../../infrastructure/scripts/with-env.mjs prisma migrate deploy",
    "db:seed": "node ../../infrastructure/scripts/with-env.mjs ts-node --transpile-only prisma/seed.ts",
    "swagger:export": "ts-node --transpile-only src/scripts/export-openapi.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.670.0",
    "@aws-sdk/s3-request-presigner": "^3.670.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "^6.2.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-metrics-otlp-http": "~0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "~0.223.0",
    "@opentelemetry/instrumentation": "~0.223.0",
    "@opentelemetry/instrumentation-express": "~0.71.0",
    "@opentelemetry/instrumentation-http": "~0.223.0",
    "@opentelemetry/resources": "~2.12.0",
    "@opentelemetry/sdk-metrics": "~2.12.0",
    "@opentelemetry/sdk-trace-base": "~2.12.0",
    "@opentelemetry/sdk-trace-node": "~2.12.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prisma/client": "^6.1.0",
    "argon2": "^0.41.1",
    "bullmq": "^5.21.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "decimal.js": "^10.4.3",
    "docx": "^9.0.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "jose": "^5.9.4",
    "nodemailer": "^10.1.0",
    "pino": "^9.5.0",
    "prisma": "^6.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuidv7": "^1.0.2",
    "yaml": "^2.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@folioverse/shared-config": "workspace:*",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.7.5",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.12.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
