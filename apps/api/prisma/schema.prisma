  FILM

  @@schema("rec")
}

enum InteractionKind {
  IMPRESSION
  CLICK
  SAVE
  UNSAVE
  LIKE
  DISLIKE
  DISMISS
  UNDISMISS
  EXPLAIN

  @@schema("rec")
}

enum RecSetMode {
