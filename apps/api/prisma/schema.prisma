  KEY_FACTS
  STUDY_NOTES
  FLASHCARDS
  QUIZ
  TASKS
  REPORT
  COMPARISON
  RISK_REPORT
  KNOWLEDGE_MAP

  @@schema("app")
}

/// Saved output of an insight action. Pinned to the source versions it was generated from;
/// `stale` is set when one of those sources gets a newer version.
