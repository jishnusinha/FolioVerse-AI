  LAB

  @@schema("rec")
}

enum EvalStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED

  @@schema("rec")
}

/// Books and films that can be recommended. Global (not workspace data); the bundled catalog is synthetic DEMO data.
model CatalogItem {
  id          String      @id @db.Uuid
  slug        String      @unique
  kind        CatalogKind
  title       String
  creators    String[]    @default([])
  year        Int?
  genres      String[]    @default([])
  moods       String[]    @default([])
  description String      @default("")
  franchise   String?
  /// Pages for books, minutes for films.
  length      Int?
  quality     Float       @default(0)
  popularity  Int         @default(0)
  coverTone   Int         @default(1) @map("cover_tone")
  isDemo      Boolean     @default(true) @map("is_demo")
  origin      String      @default("SYNTHETIC")
  externalIds Json        @default("{}") @map("external_ids")
  createdAt   DateTime    @default(now()) @map("created_at")

  themes          ItemTheme[]
