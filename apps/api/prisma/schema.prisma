// FolioVerse data model. Prisma is the sole migrator for schemas app, ai and rec.
// The langgraph schema is owned by the Python checkpointer.
// Ids are UUIDv7 generated by the application (see src/infra/prisma.service.ts).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["app", "ai", "rec"]
}

// ───────────────────────────── enums ─────────────────────────────

enum PlatformRole {
  USER
  SUPER_ADMIN

  @@schema("app")
}

enum WorkspaceKind {
  PERSONAL
  TEAM

  @@schema("app")
}

enum MemberRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER

  @@schema("app")
}

enum ProjectKind {
  KNOWLEDGE
  WRITER
  LIBRARY

  @@schema("app")
}

enum AuthTokenKind {
  EMAIL_VERIFY
  PASSWORD_RESET

  @@schema("app")
}

enum IngestionState {
  UPLOADING
  UPLOADED
  SCANNING
  PREVIEW_READY
  PARSING
  INDEXING
  READY
  PARTIAL
  FAILED
  QUARANTINED

  @@schema("app")
}

enum SourceKind {
  DOCUMENT
  BOOK

  @@schema("app")
}

enum RunStatus {
  QUEUED
  RUNNING
  STREAMING
  AWAITING_INPUT
  SUCCEEDED
  PARTIAL
  FAILED
  CANCELLED
  INTERRUPTED
  BUDGET_REJECTED

  @@schema("app")
}

enum RunOutcome {
  ANSWERED
  ABSTAINED
  PARTIAL

  @@schema("app")
}

enum CitationState {
  VALID
  WEAK
  UNRESOLVED
  PERMISSION_REVOKED
  SOURCE_PURGED

  @@schema("app")
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM

  @@schema("app")
}

enum MessageStatus {
  COMPLETE
  STREAMING
  FAILED
  ABSTAINED

  @@schema("app")
}

enum ModelStatus {
  UNVERIFIED
  VERIFIED
  DISABLED

  @@schema("app")
}

enum CostTier {
  PREFLIGHT_ESTIMATE
  LIVE_ESTIMATE
  FINALIZED
  FINAL_ESTIMATED
  RECONCILED
  VARIANCE

  @@schema("app")
}

enum CostClass {
  AI_API
  LOCAL_COMPUTE
  CLOUD_INFRA

  @@schema("app")
}

enum CostEntryType {
  ESTIMATE
  FINAL
  RECONCILIATION
  VARIANCE

  @@schema("app")
}

enum BudgetScope {
  WORKSPACE
  USER
  PROJECT

  @@schema("app")
}

enum BudgetPeriodKind {
  DAILY
  MONTHLY

  @@schema("app")
}

enum ReservationStatus {
  OPEN
  CONSUMED
  RELEASED

  @@schema("app")
}

// ───────────────────────────── identity ─────────────────────────────

model User {
  id              String       @id @db.Uuid
  email           String       @unique
  passwordHash    String       @map("password_hash")
  displayName     String       @map("display_name")
  platformRole    PlatformRole @default(USER) @map("platform_role")
  emailVerifiedAt DateTime?    @map("email_verified_at")
  preferences     Json         @default("{}")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  deletedAt       DateTime?    @map("deleted_at")

  memberships   WorkspaceMember[]
  refreshTokens RefreshToken[]
  authTokens    AuthToken[]

  @@map("users")
  @@schema("app")
}

model RefreshToken {
  id           String    @id @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  familyId     String    @map("family_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @map("replaced_by_id") @db.Uuid
  userAgent    String?   @map("user_agent")
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@map("refresh_tokens")
  @@schema("app")
}

model AuthToken {
  id        String        @id @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  kind      AuthTokenKind
  tokenHash String        @unique @map("token_hash")
  expiresAt DateTime      @map("expires_at")
  usedAt    DateTime?     @map("used_at")
  createdAt DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_tokens")
  @@schema("app")
}

// ───────────────────────────── tenancy ─────────────────────────────

model Workspace {
  id        String        @id @db.Uuid
  name      String
  kind      WorkspaceKind
  ownerId   String        @map("owner_id") @db.Uuid
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  deletedAt DateTime?     @map("deleted_at")

  members     WorkspaceMember[]
  invitations Invitation[]
  projects    Project[]

  @@map("workspaces")
  @@schema("app")
}

model WorkspaceMember {
  workspaceId String     @map("workspace_id") @db.Uuid
  userId      String     @map("user_id") @db.Uuid
  role        MemberRole
  createdAt   DateTime   @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@map("workspace_members")
  @@schema("app")
}

model Invitation {
  id          String     @id @db.Uuid
  workspaceId String     @map("workspace_id") @db.Uuid
  email       String
  role        MemberRole
  tokenHash   String     @unique @map("token_hash")
  invitedById String     @map("invited_by_id") @db.Uuid
  expiresAt   DateTime   @map("expires_at")
  acceptedAt  DateTime?  @map("accepted_at")
  createdAt   DateTime   @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("invitations")
  @@schema("app")
}

model Project {
  id          String      @id @db.Uuid
  workspaceId String      @map("workspace_id") @db.Uuid
  name        String
  kind        ProjectKind
  description String      @default("")
  createdById String      @map("created_by_id") @db.Uuid
  archivedAt  DateTime?   @map("archived_at")
  deletedAt   DateTime?   @map("deleted_at")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  folders   Folder[]
  sources   Source[]

  @@unique([workspaceId, id])
  @@index([workspaceId, kind])
  @@map("projects")
  @@schema("app")
}

model Folder {
  id          String    @id @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  parentId    String?   @map("parent_id") @db.Uuid
  name        String
  path        String
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  project Project @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, id])
  @@index([projectId, path])
  @@map("folders")
  @@schema("app")
}

// ───────────────────────────── sources ─────────────────────────────

model StoredObject {
  id          String   @id @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  bucket      String
  key         String
  sizeBytes   Int      @map("size_bytes")
  sha256      String
  mimeType    String   @map("mime_type")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([workspaceId, id])
  @@map("stored_objects")
  @@schema("app")
}

model UploadSession {
  id          String         @id @db.Uuid
  workspaceId String         @map("workspace_id") @db.Uuid
  projectId   String         @map("project_id") @db.Uuid
  folderId    String?        @map("folder_id") @db.Uuid
  userId      String         @map("user_id") @db.Uuid
  sourceId    String?        @map("source_id") @db.Uuid
  filename    String
  mimeType    String         @map("mime_type")
  sizeBytes   Int            @map("size_bytes")
  objectKey   String         @map("object_key")
  state       IngestionState @default(UPLOADING)
  expiresAt   DateTime       @map("expires_at")
  completedAt DateTime?      @map("completed_at")
  createdAt   DateTime       @default(now()) @map("created_at")

  @@map("upload_sessions")
  @@schema("app")
}

model Source {
  id               String         @id @db.Uuid
  workspaceId      String         @map("workspace_id") @db.Uuid
  projectId        String         @map("project_id") @db.Uuid
  folderId         String?        @map("folder_id") @db.Uuid
  title            String
  kind             SourceKind     @default(DOCUMENT)
  mimeType         String         @map("mime_type")
  currentVersionId String?        @map("current_version_id") @db.Uuid
  ingestionState   IngestionState @default(UPLOADING) @map("ingestion_state")
  tags             String[]       @default([])
  createdById      String         @map("created_by_id") @db.Uuid
  deletedAt        DateTime?      @map("deleted_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  project  Project         @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Cascade)
  versions SourceVersion[]

  @@unique([workspaceId, id])
  @@index([workspaceId, projectId])
  @@map("sources")
  @@schema("app")
}

model SourceVersion {
  id             String         @id @db.Uuid
  workspaceId    String         @map("workspace_id") @db.Uuid
  sourceId       String         @map("source_id") @db.Uuid
  versionNo      Int            @map("version_no")
  storedObjectId String         @map("stored_object_id") @db.Uuid
  mimeType       String         @map("mime_type")
  sha256         String
  sizeBytes      Int            @map("size_bytes")
  pageCount      Int?           @map("page_count")
  ingestionState IngestionState @default(UPLOADED) @map("ingestion_state")
  ingestionError String?        @map("ingestion_error")
  createdById    String         @map("created_by_id") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at")

  source Source @relation(fields: [workspaceId, sourceId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, id])
  @@unique([sourceId, versionNo])
  @@map("source_versions")
  @@schema("app")
}

model IngestionJob {
  id              String         @id @db.Uuid
  workspaceId     String         @map("workspace_id") @db.Uuid
  sourceVersionId String         @map("source_version_id") @db.Uuid
  state           IngestionState
  attempts        Int            @default(0)
  error           String?
  stats           Json?
  startedAt       DateTime?      @map("started_at")
  finishedAt      DateTime?      @map("finished_at")
  createdAt       DateTime       @default(now()) @map("created_at")

  @@index([sourceVersionId])
  @@map("ingestion_jobs")
  @@schema("app")
}

// ───────────────────────────── ai (derived, written by the AI service) ─────────────────────────────

model IndexManifest {
  id              String   @id @db.Uuid
  workspaceId     String   @map("workspace_id") @db.Uuid
  sourceVersionId String   @unique @map("source_version_id") @db.Uuid
  collection      String
  embedder        String
  dims            Int
  parentCount     Int      @map("parent_count")
  childCount      Int      @map("child_count")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("index_manifests")
  @@schema("ai")
}

model SourcePage {
  id              String @id @db.Uuid
  workspaceId     String @map("workspace_id") @db.Uuid
  sourceVersionId String @map("source_version_id") @db.Uuid
  pageNo          Int    @map("page_no")
  text            String
  width           Float?
  height          Float?

  @@unique([sourceVersionId, pageNo])
  @@map("source_pages")
  @@schema("ai")
}

model Chunk {
  id              String   @id @db.Uuid
  workspaceId     String   @map("workspace_id") @db.Uuid
  sourceVersionId String   @map("source_version_id") @db.Uuid
  parentId        String?  @map("parent_id") @db.Uuid
  level           String
  ordinal         Int
  text            String
  tokenCount      Int      @map("token_count")
  pageStart       Int?     @map("page_start")
  pageEnd         Int?     @map("page_end")
  locator         Json
  headingPath     String[] @default([]) @map("heading_path")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([sourceVersionId, level, ordinal])
  @@map("chunks")
  @@schema("ai")
}

model RetrievalEvent {
  id          String   @id @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  runId       String   @map("run_id") @db.Uuid
  query       String
  params      Json
  candidates  Json
  packed      Json
  latencyMs   Float    @map("latency_ms")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([runId])
  @@map("retrieval_events")
  @@schema("ai")
}

model EmbeddingCache {
  key       String   @id
  embedder  String
  vector    Json
  createdAt DateTime @default(now()) @map("created_at")

  @@map("embedding_cache")
  @@schema("ai")
}

// ───────────────────────────── conversations ─────────────────────────────

model ContextScope {
  id               String   @id @db.Uuid
  workspaceId      String   @map("workspace_id") @db.Uuid
  projectId        String?  @map("project_id") @db.Uuid
  sourceVersionIds String[] @map("source_version_ids") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("context_scopes")
  @@schema("app")
}

model Thread {
  id             String    @id @db.Uuid
  workspaceId    String    @map("workspace_id") @db.Uuid
  projectId      String?   @map("project_id") @db.Uuid
  sourceId       String?   @map("source_id") @db.Uuid
  title          String
  contextScopeId String?   @map("context_scope_id") @db.Uuid
  createdById    String    @map("created_by_id") @db.Uuid
  archivedAt     DateTime? @map("archived_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  messages Message[]

  @@unique([workspaceId, id])
  @@index([workspaceId, sourceId])
  @@map("threads")
  @@schema("app")
}

model Message {
  id              String        @id @db.Uuid
  workspaceId     String        @map("workspace_id") @db.Uuid
  threadId        String        @map("thread_id") @db.Uuid
  parentMessageId String?       @map("parent_message_id") @db.Uuid
  role            MessageRole
  content         String
  status          MessageStatus @default(COMPLETE)
  aiRunId         String?       @map("ai_run_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at")

  thread    Thread            @relation(fields: [workspaceId, threadId], references: [workspaceId, id], onDelete: Cascade)
  citations MessageCitation[]

  @@unique([workspaceId, id])
  @@index([threadId, createdAt])
  @@map("messages")
  @@schema("app")
}

model MessageCitation {
  id              String        @id @db.Uuid
  workspaceId     String        @map("workspace_id") @db.Uuid
  messageId       String        @map("message_id") @db.Uuid
  marker          String
  chunkId         String?       @map("chunk_id") @db.Uuid
  sourceVersionId String        @map("source_version_id") @db.Uuid
  state           CitationState
  score           Float         @default(0)
  quote           String        @default("")
  anchor          Json

  message Message @relation(fields: [workspaceId, messageId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([messageId, marker])
  @@map("message_citations")
  @@schema("app")
}

// ───────────────────────────── AI run ledger ─────────────────────────────

model AiRun {
  id                   String      @id @db.Uuid
  workspaceId          String      @map("workspace_id") @db.Uuid
  userId               String      @map("user_id") @db.Uuid
  threadId             String?     @map("thread_id") @db.Uuid
  messageId            String?     @map("message_id") @db.Uuid
  graph                String
  tier                 String
  status               RunStatus   @default(QUEUED)
  outcome              RunOutcome?
  input                Json
  scope                Json?
  modelPlan            Json?       @map("model_plan")
  options              Json?
  result               Json?
  isDemo               Boolean     @default(false) @map("is_demo")
  lab                  Boolean     @default(false)
  parentRunId          String?     @map("parent_run_id") @db.Uuid
  forkedFromCheckpoint String?     @map("forked_from_checkpoint")
  error                Json?
  lastSeq              Int         @default(0) @map("last_seq")
  heartbeatAt          DateTime?   @map("heartbeat_at")
  startedAt            DateTime?   @map("started_at")
  finishedAt           DateTime?   @map("finished_at")
  createdAt            DateTime    @default(now()) @map("created_at")

  @@unique([workspaceId, id])
  @@index([workspaceId, createdAt])
  @@index([status, heartbeatAt])
  @@map("ai_runs")
  @@schema("app")
}

model AiRunEvent {
  id          String   @id @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  runId       String   @map("run_id") @db.Uuid
  seq         Int
  type        String
  data        Json
  ts          DateTime @default(now())

  @@unique([runId, seq])
  @@map("ai_run_events")
  @@schema("app")
}

model NodeExecution {
  id          String    @id @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  runId       String    @map("run_id") @db.Uuid
  node        String
  step        Int
  status      String
  startedAt   DateTime  @map("started_at")
  finishedAt  DateTime? @map("finished_at")
  durationMs  Float?    @map("duration_ms")
  summary     Json?

  @@unique([runId, step, node])
  @@map("node_executions")
  @@schema("app")
}

model ModelConfig {
  id              String      @id
  provider        String
  model           String
  displayName     String      @map("display_name")
  status          ModelStatus @default(UNVERIFIED)
  contextWindow   Int         @map("context_window")
  maxOutputTokens Int         @map("max_output_tokens")
  capabilities    String[]    @default([])
  isDemo          Boolean     @default(false) @map("is_demo")
  isDefault       Boolean     @default(false) @map("is_default")
  fallbackIds     String[]    @default([]) @map("fallback_ids")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  prices ModelPrice[]

  @@map("model_configs")
  @@schema("app")
}

model ModelPrice {
  id                 String    @id @db.Uuid
  modelConfigId      String    @map("model_config_id")
  inputPerMTok       Decimal   @map("input_per_mtok") @db.Decimal(18, 8)
  outputPerMTok      Decimal   @map("output_per_mtok") @db.Decimal(18, 8)
  cachedInputPerMTok Decimal?  @map("cached_input_per_mtok") @db.Decimal(18, 8)
  reasoningPerMTok   Decimal?  @map("reasoning_per_mtok") @db.Decimal(18, 8)
  batchDiscount      Decimal?  @map("batch_discount") @db.Decimal(6, 4)
  currency           String    @default("USD")
  effectiveFrom      DateTime  @map("effective_from")
  effectiveTo        DateTime? @map("effective_to")
  sourceUrl          String    @map("source_url")
  isDemo             Boolean   @default(false) @map("is_demo")
  enteredById        String?   @map("entered_by_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at")

  modelConfig ModelConfig @relation(fields: [modelConfigId], references: [id], onDelete: Cascade)

  @@index([modelConfigId, effectiveFrom])
  @@map("model_prices")
  @@schema("app")
}

model ModelCall {
  id            String   @id @db.Uuid
  workspaceId   String   @map("workspace_id") @db.Uuid
  runId         String   @map("run_id") @db.Uuid
  modelConfigId String   @map("model_config_id")
  provider      String
  model         String
  attempt       Int      @default(1)
  status        String
  latencyMs     Float?   @map("latency_ms")
  errorClass    String?  @map("error_class")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([runId])
  @@map("model_calls")
  @@schema("app")
}

model UsageEvent {
  id                String    @id @db.Uuid
  workspaceId       String    @map("workspace_id") @db.Uuid
  runId             String?   @map("run_id") @db.Uuid
  userId            String?   @map("user_id") @db.Uuid
  modelCallId       String?   @map("model_call_id") @db.Uuid
  modelConfigId     String?   @map("model_config_id")
  costClass         CostClass @default(AI_API) @map("cost_class")
  provider          String
  model             String
  inputTokens       Int       @default(0) @map("input_tokens")
  outputTokens      Int       @default(0) @map("output_tokens")
  cachedInputTokens Int       @default(0) @map("cached_input_tokens")
  reasoningTokens   Int       @default(0) @map("reasoning_tokens")
  computeSeconds    Decimal?  @map("compute_seconds") @db.Decimal(18, 6)
  reported          Boolean   @default(true)
  isDemo            Boolean   @default(false) @map("is_demo")
  feature           String?
  processedAt       DateTime? @map("processed_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@index([workspaceId, createdAt])
  @@index([processedAt])
  @@map("usage_events")
  @@schema("app")
}

model CostEntry {
  id                String        @id @db.Uuid
  workspaceId       String        @map("workspace_id") @db.Uuid
  userId            String?       @map("user_id") @db.Uuid
  runId             String?       @map("run_id") @db.Uuid
  usageEventId      String?       @map("usage_event_id") @db.Uuid
  modelCallId       String?       @map("model_call_id") @db.Uuid
  modelConfigId     String?       @map("model_config_id")
  entryType         CostEntryType @map("entry_type")
  tier              CostTier
  costClass         CostClass     @default(AI_API) @map("cost_class")
  amount            Decimal       @db.Decimal(18, 8)
  currency          String        @default("USD")
  priceId           String?       @map("price_id") @db.Uuid
  reason            String?
  supersedesEntryId String?       @map("supersedes_entry_id") @db.Uuid
  feature           String?
  isDemo            Boolean       @default(false) @map("is_demo")
  createdAt         DateTime      @default(now()) @map("created_at")

  @@unique([usageEventId, entryType])
  @@unique([modelCallId, tier])
  @@index([workspaceId, createdAt])
  @@index([runId])
  @@map("cost_entries")
  @@schema("app")
}

model BudgetPolicy {
  id              String           @id @db.Uuid
  workspaceId     String           @map("workspace_id") @db.Uuid
  scope           BudgetScope
  scopeRefId      String?          @map("scope_ref_id") @db.Uuid
  period          BudgetPeriodKind @default(MONTHLY)
  limitAmount     Decimal          @map("limit_amount") @db.Decimal(18, 8)
  currency        String           @default("USD")
  hard            Boolean          @default(true)
  alertThresholds Int[]            @default([75, 90, 100]) @map("alert_thresholds")
  createdAt       DateTime         @default(now()) @map("created_at")

  periods BudgetPeriod[]

  @@map("budget_policies")
  @@schema("app")
}

model BudgetPeriod {
  id           String   @id @db.Uuid
  workspaceId  String   @map("workspace_id") @db.Uuid
  policyId     String   @map("policy_id") @db.Uuid
  periodStart  DateTime @map("period_start")
  periodEnd    DateTime @map("period_end")
  limitAmount  Decimal  @map("limit_amount") @db.Decimal(18, 8)
  spentFinal   Decimal  @default(0) @map("spent_final") @db.Decimal(18, 8)
  reservedOpen Decimal  @default(0) @map("reserved_open") @db.Decimal(18, 8)
  alertsSent   Int[]    @default([]) @map("alerts_sent")

