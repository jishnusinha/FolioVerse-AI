{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://folioverse.dev/schemas/model-plan.schema.json",
  "title": "ModelPlan",
  "description": "Resolved at admission by the API. The AI service may only fall back to models listed here.",
  "type": "object",
  "required": ["primary", "fallbacks", "maxOutputTokens", "temperature", "isDemo"],
  "additionalProperties": false,
  "$defs": {
    "ModelRef": {
      "type": "object",
      "required": ["modelConfigId", "provider", "model"],
      "additionalProperties": false,
      "properties": {
        "modelConfigId": { "type": "string" },
        "provider": { "enum": ["mock", "openai", "ollama"] },
        "model": { "type": "string" },
        "contextWindow": { "type": "integer" }
      }
    }
  },
  "properties": {
    "primary": { "$ref": "#/$defs/ModelRef" },
    "fallbacks": { "type": "array", "items": { "$ref": "#/$defs/ModelRef" } },
    "maxOutputTokens": { "type": "integer", "minimum": 1 },
    "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
    "isDemo": { "type": "boolean" },
    "reservation": {
      "type": "object",
      "properties": {
        "reservationId": { "type": "string" },
        "amount": { "type": "string" },
        "currency": { "type": "string" }
      }
    },
    "budgetGuard": {
      "description": "Set only under a hard budget. The graph stops before generating when its real prompt could cost more than maxCost.",
      "type": "object",
      "required": ["maxCost", "prices"],
      "additionalProperties": false,
      "properties": {
        "maxCost": { "type": "string" },
        "prices": {
          "type": "object",
          "required": ["inputPerMTok", "outputPerMTok"],
          "additionalProperties": false,
          "properties": {
            "inputPerMTok": { "type": "string" },
            "outputPerMTok": { "type": "string" },
            "cachedInputPerMTok": { "type": ["string", "null"] },
            "reasoningPerMTok": { "type": ["string", "null"] },
            "batchDiscount": { "type": ["string", "null"] }
          }
        }
      }
    }
  }
}
