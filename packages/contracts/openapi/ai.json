  "components": {
    "schemas": {
      "EvaluateRequest": {
        "properties": {
          "k": {
            "type": "integer",
            "maximum": 50.0,
            "minimum": 1.0,
            "title": "K",
            "default": 10
          },
          "maxUsers": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Maxusers"
          }
        },
        "type": "object",
        "title": "EvaluateRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IngestUnit": {
        "properties": {
          "jobId": {
            "type": "string",
            "title": "Jobid"
          },
          "workspaceId": {
            "type": "string",
            "title": "Workspaceid"
          },
          "projectId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Projectid"
          },
          "sourceId": {
            "type": "string",
            "title": "Sourceid"
          },
          "sourceVersionId": {
            "type": "string",
            "title": "Sourceversionid"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "mimeType": {
            "type": "string",
            "title": "Mimetype"
          },
          "objectUrl": {
            "type": "string",
            "title": "Objecturl"
          },
          "sha256": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sha256"
          }
        },
        "type": "object",
        "required": [
          "jobId",
          "workspaceId",
          "sourceId",
          "sourceVersionId",
          "mimeType",
          "objectUrl"
        ],
        "title": "IngestUnit"
      },
      "PurgeRequest": {
        "properties": {
          "workspaceId": {
            "type": "string",
            "title": "Workspaceid"
          },
          "sourceVersionIds": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Sourceversionids"
          }
        },
        "type": "object",
        "required": [
          "workspaceId",
          "sourceVersionIds"
        ],
        "title": "PurgeRequest"
      },
      "RecommendRequest": {
        "properties": {
          "requestId": {
            "type": "string",
            "title": "Requestid"
          },
          "workspaceId": {
            "type": "string",
            "title": "Workspaceid"
          },
          "profile": {
            "additionalProperties": true,
            "type": "object",
            "title": "Profile"
          },
          "request": {
            "additionalProperties": true,
            "type": "object",
            "title": "Request"
          }
        },
        "type": "object",
        "required": [
          "requestId",
          "workspaceId"
        ],
        "title": "RecommendRequest"
      },
      "RunUnit": {
        "properties": {
          "runId": {
            "type": "string",
            "title": "Runid"
          },
          "workspaceId": {
            "type": "string",
            "title": "Workspaceid"
          },
          "graph": {
            "type": "string",
            "title": "Graph"
          },
          "input": {
            "additionalProperties": true,
            "type": "object",
            "title": "Input"
          },
          "history": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "History"
          },
          "modelPlan": {
            "additionalProperties": true,
            "type": "object",
            "title": "Modelplan"
          },
          "scopeToken": {
            "type": "string",
            "title": "Scopetoken"
          },
          "options": {
            "additionalProperties": true,
            "type": "object",
            "title": "Options"
          },
          "resumeFromCheckpoint": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Resumefromcheckpoint"
          },
          "parentRunId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parentrunid"
          },
          "userId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Userid"
          }
        },
        "type": "object",
        "required": [
          "runId",
          "workspaceId",
          "graph",
          "modelPlan",
          "scopeToken"
        ],
        "title": "RunUnit"
      },
      "SearchRequest": {
        "properties": {
          "searchId": {
            "type": "string",
            "title": "Searchid"
          },
          "workspaceId": {
            "type": "string",
            "title": "Workspaceid"
          },
          "query": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Query"
          },
          "scopeToken": {
            "type": "string",
            "title": "Scopetoken"
          },
          "topK": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Topk",
            "default": 8
          }
        },
        "type": "object",
        "required": [
          "searchId",
          "workspaceId",
          "query",
          "scopeToken"
        ],
        "title": "SearchRequest"
      },
      "SimilarRequest": {
        "properties": {
          "itemId": {
            "type": "string",
            "title": "Itemid"
          },
          "k": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "K",
            "default": 6
          },
          "otherKind": {
            "type": "boolean",
            "title": "Otherkind",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "itemId"
        ],
        "title": "SimilarRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
