{
  "description": "Reader Locator → ingested page (EPUB chapter = page). Used by apps/api library/locator.ts and apps/web features/reader/locator.js. `chapters` mirrors ingestion stats.chapters; `page` null means the locator cannot be placed and the reader must not be sent past its known position.",
  "chapters": [
    { "page": 1, "href": "Text/chapter-1.xhtml", "title": "Chapter 1 — The Halcyon Ring", "idref": "ch1" },
