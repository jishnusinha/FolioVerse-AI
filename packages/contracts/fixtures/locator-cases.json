    { "name": "pdf page", "locator": { "type": "application/pdf", "locations": { "page": 7 } }, "page": 7 },
    { "name": "position fallback", "locator": { "locations": { "position": 2 } }, "page": 2 },
    { "name": "unknown href", "locator": { "href": "Text/appendix.xhtml" }, "page": null },
    { "name": "basename must not match a longer name", "locator": { "href": "Text/chapter-11.xhtml" }, "page": null },
    { "name": "empty locator", "locator": {}, "page": null }
  ]
