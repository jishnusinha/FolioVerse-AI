    { "page": 3, "href": "Text/chapter-3.xhtml", "title": "Chapter 3 — A Lantern Fails", "idref": "ch3" },
    { "page": 4, "href": "Text/chapter-4.xhtml", "title": "Chapter 4 — Perihelion", "idref": "ch4" }
  ],
  "cases": [
    { "name": "exact href", "locator": { "href": "Text/chapter-2.xhtml" }, "page": 2 },
