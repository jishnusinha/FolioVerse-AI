    { "name": "href relative to a different base", "locator": { "href": "OEBPS/Text/chapter-4.xhtml" }, "page": 4 },
    { "name": "href with leading ./", "locator": { "href": "./Text/chapter-1.xhtml" }, "page": 1 },
    { "name": "percent-encoded href", "locator": { "href": "Text/chapter%2D2.xhtml" }, "page": 2 },
    { "name": "cfi idref when href is missing", "locator": { "locations": { "cfi": "epubcfi(/6/6[ch3]!/4/2/1:0)" } }, "page": 3 },
