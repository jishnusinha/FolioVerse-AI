{
  "name": "folioverse",
  "private": true,
  "version": "0.1.0",
  "description": "FolioVerse AI — knowledge, writing, reading and discovery platform",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node infrastructure/scripts/dev.mjs",
    "gen-keys": "node infrastructure/scripts/gen-keys.mjs",
    "up": "node infrastructure/scripts/up.mjs",
    "down": "node infrastructure/scripts/down.mjs",
    "check:env": "node infrastructure/scripts/check-env.mjs",
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test && pnpm run test:infra && pnpm run test:py",
    "test:infra": "node --test \"infrastructure/tests/*.test.mjs\" && node infrastructure/grafana/generate.mjs --check",
    "backup": "node infrastructure/scripts/backup.mjs",
    "restore": "node infrastructure/scripts/restore.mjs",
    "backup:drill": "node infrastructure/scripts/backup-restore-test.mjs",
    "smoke:deployed": "node infrastructure/scripts/smoke-deployed.mjs",
    "test:py": "python -m uv run --directory apps/ai-service pytest -q && python -m uv run --directory packages/folioverse-ml pytest -q",
    "test:integration": "pnpm --filter @folioverse/api run test:integration",
    "test:e2e": "pnpm --filter @folioverse/web run test:e2e",
    "test:security": "node tests/security/run.mjs",
    "contracts:gen": "node packages/contracts/scripts/generate.mjs",
    "contracts:check": "node packages/contracts/scripts/check.mjs",
    "tokens:build": "pnpm --filter @folioverse/design-tokens run build",
    "db:migrate": "pnpm --filter @folioverse/api run db:migrate",
    "db:seed": "pnpm --filter @folioverse/api run db:seed",
    "demo": "node infrastructure/scripts/demo.mjs",
    "perf": "node infrastructure/scripts/perf.mjs",
    "docs:build": "pnpm --filter @folioverse/docs run build",
    "docs:dev": "pnpm --filter @folioverse/docs run dev",
    "docs:shots": "pnpm --filter @folioverse/web run docs:shots",
    "kaggle:smoke": "node ml-notebooks/run-smoke.mjs",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  },
  "pnpm": {
    "overrides": {
      "@xmldom/xmldom@<0.8.15": "^0.8.15",
      "js-yaml@>=5 <5.4.1": "^5.4.3",
      "deepmerge-ts@<8": "^8.0.2",
      "postcss-selector-parser@<7.1.6": "^7.1.6"
    }
  }
}
